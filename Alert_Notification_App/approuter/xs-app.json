{
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/api/(.*)$",
      "target": "/api/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/ewmalertlog/(.*)$",
      "target": "$1",
      "localDir": "resources/ewmalertlog/webapp",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/$",
      "target": "index.html",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    }
  ]
}
